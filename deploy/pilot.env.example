# Copy outside Git as .env.pilot and replace every REQUIRED value.
PILOT_HOST=pilot.invalid
TLS_CONTACT_EMAIL=operator@example.invalid
APP_ENV=production
DATABASE_URL=postgresql+asyncpg://pilot:REQUIRED@postgres:5432/pilot
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["https://pilot.invalid"]
TRUSTED_HOSTS=["pilot.invalid","api"]
POSTGRES_DB=pilot
POSTGRES_USER=pilot
POSTGRES_PASSWORD=REQUIRED
STUDY_ENROLLMENT_ENABLED=false
STUDY_ADMIN_KEY=REQUIRED_32_BYTES
STUDY_CODE_PEPPER=REQUIRED_32_BYTES
STUDY_MIN_RETURN_HOURS=24
STUDY_RATE_LIMIT_ATTEMPTS=12
STUDY_RATE_LIMIT_WINDOW_SECONDS=60
MODEL_PROVIDER=disabled
WORLD_RUNTIME_ENABLED=false
