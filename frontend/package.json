{
    "name": "ai-world-simulator-frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --hostname 0.0.0.0",
        "build": "next build",
        "start": "next start",
        "lint": "eslint src scripts/*.mjs next.config.ts tailwind.config.ts vitest.config.ts",
        "typecheck": "tsc --noEmit",
        "generate:domain-types": "node scripts/generate-domain-types.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.66.0",
        "next": "15.5.22",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "zustand": "^5.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.10.2",
        "@playwright/test": "^1.62.0",
        "@testing-library/jest-dom": "^6.6.0",
        "@testing-library/react": "^16.2.0",
        "@types/node": "^22.13.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.4.0",
        "eslint": "^8.57.0",
        "eslint-config-next": "^15.2.0",
        "jsdom": "^26.0.0",
        "json-schema-to-typescript": "^15.0.4",
        "prettier": "^3.5.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.7.0",
        "vitest": "^3.0.0"
    },
    "overrides": {
        "next": {
            "postcss": "8.5.25",
            "sharp": "0.35.3"
        }
    }
}
