{
  "$defs": {
    "JSONObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JSONValue"
      },
      "type": "object"
    },
    "JSONPrimitive": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JSONPrimitive"
        },
        {
          "items": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          },
          "type": "object"
        }
      ]
    },
    "NonEmptyString": {
      "minLength": 1,
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "failure_predicate": {
      "$ref": "#/$defs/JSONObject"
    },
    "horizon_world_time": {
      "$ref": "#/$defs/Timestamp"
    },
    "id": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "objective_type": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "owner_id": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "priority": {
      "maximum": 100,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "privacy_class": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "status": {
      "$ref": "#/$defs/NonEmptyString"
    },
    "success_predicate": {
      "$ref": "#/$defs/JSONObject"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "world_id": {
      "$ref": "#/$defs/NonEmptyString"
    }
  },
  "required": [
    "id",
    "world_id",
    "owner_id",
    "objective_type",
    "priority",
    "status",
    "horizon_world_time",
    "success_predicate",
    "failure_predicate",
    "privacy_class",
    "version",
    "schema_version"
  ],
  "title": "AgentGoal",
  "type": "object"
}
