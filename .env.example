APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://simulator:simulator@localhost:5432/simulator
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
POSTGRES_DB=simulator
POSTGRES_USER=simulator
POSTGRES_PASSWORD=simulator
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# Model decisions start safely disabled. Never commit a real key.
MODEL_PROVIDER=disabled
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com
